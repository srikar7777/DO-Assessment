# Application identity
APP_NAME=myservice
APP_VERSION=0.1.0
APP_PORT=8000
# development | staging | production
ENVIRONMENT=development

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database
# SQLite (local): sqlite:///./myservice.db
# PostgreSQL (prod): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./myservice.db

# ---------------------------------------------------------------------------
# Storage backend: local | s3
# Use "local" for development; "s3" for DigitalOcean Spaces / AWS S3 in prod
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Object storage (DigitalOcean Spaces / S3-compatible). Required when
# STORAGE_BACKEND=s3. Leave blank for local development.
S3_ENDPOINT_URL=
S3_REGION=nyc3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL for serving files (e.g. CDN / Spaces CDN)
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Security / customer-facing controls
# ---------------------------------------------------------------------------
# Comma-separated origins. Use "*" only for local demos — never in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API key required on mutating endpoints when set.
# Leave empty to disable auth in local development only.
API_KEY=

# Rate limiting (per client IP). 0 disables the limiter.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Upload limits
MAX_UPLOAD_BYTES=10485760
MAX_IMAGES_PER_REQUEST=10

# Default thumbnail quality (1-100) for JPEG/WebP outputs
DEFAULT_THUMBNAIL_QUALITY=85
